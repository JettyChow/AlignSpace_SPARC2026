# Auth — Clerk (https://dashboard.clerk.com). Required for signup/login to
# work; without these set, the app will error when it tries to render
# <ClerkProvider>. Never commit the real values.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# AI pipeline service (as-ai-server). Defaults to http://localhost:8000 if unset.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Main backend (projects/chat/materials — GET/POST /projects, etc.). No
# default: until this points at a running instance, project.service.js calls
# fail and screens that depend on them (History, Entry's project teasers)
# show their empty/error state rather than mock data.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8001
